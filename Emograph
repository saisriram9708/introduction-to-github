// Real-time messaging and notifications
io.on("connection", (socket) => {
  console.log("User connected:", socket.id);

  socket.on("sendMessage", ({ senderId, receiverId, text }) => {
    socket.broadcast.emit(`message-${receiverId}", { senderId, text });
    socket.broadcast.emit(`notify-${receiverId}", { type: "message", from: senderId, text });
  });

  socket.on("postLike", ({ postId, likerId, ownerId }) => {
    socket.broadcast.emit(`notify-${ownerId}", { type: "like", from: likerId, postId });
  });

  socket.on("comment", ({ postId, commenterId, ownerId }) => {
    socket.broadcast.emit(`notify-${ownerId}", { type: "comment", from: commenterId, postId });
  });

  socket.on("disconnect", () => {
    console.log("User disconnected:", socket.id);
  });
});

server.listen(5000, () => console.log("Server running on port 5000"));

// --- utils/aiModeration.js ---
const toxicWords = ["hate", "kill", "attack", "stupid", "ugly"];

function isToxic(content) {
  return toxicWords.some((word) => content.toLowerCase().includes(word));
}

module.exports = { isToxic };

// --- utils/recommendationEngine.js ---
const Post = require("../models/Post");
const User = require("../models/User");

async function recommendPosts(userId) {
  const user = await User.findById(userId);
  const posts = await Post.find({ userId: { $nin: user.following.concat([user._id]) } }).sort({ createdAt: -1 }).limit(10);
  return posts;
}

module.exports = { recommendPosts };

// --- utils/upload.js ---
const multer = require("multer");
const path = require("path");

const storage = multer.diskStorage({
  destination: (req, file, cb) => cb(null, "uploads/"),
  filename: (req, file, cb) => cb(null, Date.now() + path.extname(file.originalname))
});

const upload = multer({ storage });
module.exports = upload;

// --- utils/captionGenerator.js ---
const mobilenetModel = mobilenet.load;

async function generateImageCaption(imagePath) {
  const imageBuffer = fs.readFileSync(imagePath);
  const resizedImage = await sharp(imageBuffer).resize(224, 224).toBuffer();
  const imageTensor = tf.node.decodeImage(resizedImage);
  const model = await mobilenetModel();
  const predictions = await model.classify(imageTensor);
  return predictions.map(p => p.className).slice(0, 3).join(", ");
}

module.exports = { generateImageCaption };

