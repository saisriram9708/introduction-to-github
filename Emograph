// --- routes/post.js ---
const express = require("express");
const Post = require("../models/Post");
const auth = require("../utils/authMiddleware");
const { isToxic } = require("../utils/aiModeration");
const { recommendPosts } = require("../utils/recommendationEngine");
const { generateImageCaption } = require("../utils/captionGenerator");
const upload = require("../utils/upload");
const router = express.Router();

// Create post with moderation and AI-generated caption
router.post("/", auth, upload.single("image"), async (req, res) => {
  const { content } = req.body;
  if (isToxic(content)) return res.status(400).json("Content violates community guidelines");
  let aiCaption = "";
  if (req.file) {
    try {
      aiCaption = await generateImageCaption(`uploads/${req.file.filename}`);
    } catch (e) {
      console.error("Caption error:", e);
    }
  }
  const post = new Post({ userId: req.user.id, content, image: req.file?.filename, aiCaption });
  await post.save();
  res.json(post);
});

// Other post routes (like, comment, feed, recommend) remain unchanged

module.exports = router;

